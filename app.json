{
  "expo": {
    "name": "Surgical World Billing",
    "slug": "surgical-world-billing",
    "owner": "sugical-world-billing",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bc28de11-34c2-4ac7-9246-c7d9a27f750c"
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "surgicalworld",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8FC"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.surgicalworld.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F8FC"
      }
    },
    "ios": {
      "bundleIdentifier": "com.surgicalworld.app",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "bc28de11-34c2-4ac7-9246-c7d9a27f750c"
      }
    }
  }
}
